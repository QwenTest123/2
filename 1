#!/bin/bash

set -euo pipefail

# ====================== Цвета ======================
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

info()  { echo -e "${CYAN}[INFO]${NC} $1"; }
ok()    { echo -e "${GREEN}[OK]${NC} $1"; }
warn()  { echo -e "${YELLOW}[WARN]${NC} $1"; }
error() { echo -e "${RED}[ERROR]${NC} $1"; exit 1; }

# ====================== Проверки ======================
[[ $EUID -ne 0 ]] && error "Запускай от root"

if ! command -v apt-get &> /dev/null; then
    error "Этот скрипт предназначен только для Debian/Ubuntu"
fi

export DEBIAN_FRONTEND=noninteractive

# ====================== Полная защита сервера ======================
info "Настройка максимальной безопасности сервера..."
info "Устанавливаю fail2ban и unattended-upgrades..."
apt-get update -qq
apt-get install -y -qq curl openssl ca-certificates fail2ban unattended-upgrades > /dev/null

# Настройка автоматических обновлений безопасности
echo 'Unattended-Upgrade::Allowed-Origins:: "${distro_id}:${distro_codename}-security";' > /etc/apt/apt.conf.d/50unattended-upgrades
systemctl enable --now unattended-upgrades
systemctl enable --now fail2ban

# Спрашиваем про отключение SSH
echo
warn "⚠️  ВНИМАНИЕ: Ты можешь полностью отключить SSH-сервер."
warn "После этого войти на сервер можно будет ТОЛЬКО через VNC/веб-консоль хостинга."
warn "Убедись, что ты знаешь root-пароль и консоль хостинга работает исправно!"
read -p "Отключить SSH полностью? (y/N): " DISABLE_SSH
if [[ "$DISABLE_SSH" =~ ^[Yy]$ ]]; then
    info "Останавливаю и отключаю SSH..."
    systemctl stop sshd || true
    systemctl disable sshd || true
    if command -v ufw &>/dev/null; then
        ufw deny 22/tcp > /dev/null 2>&1 || true
    fi
    ok "SSH полностью отключен."
else
    info "SSH оставлен включенным. Настоятельно рекомендую использовать SSH-ключи вместо пароля!"
fi

# ====================== Выбор порта ======================
echo
info "Выбор порта для Hysteria2"
echo "1) Случайный высокий порт (рекомендуется)"
echo "2) Указать свой порт"
read -p "Выбери [1/2] (по умолчанию 1): " PORT_CHOICE
PORT_CHOICE=${PORT_CHOICE:-1}

if [[ "$PORT_CHOICE" == "2" ]]; then
    read -p "Введи UDP порт (30000-60000): " HY2_PORT
    [[ -z "${HY2_PORT}" || "${HY2_PORT}" -lt 30000 || "${HY2_PORT}" -gt 60000 ]] && error "Некорректный порт. Используйте диапазон 30000-60000"
else
    HY2_PORT=$((RANDOM % 25000 + 35000))
fi

ok "Порт: ${HY2_PORT}/udp"

# ====================== Генерация данных для 4-х клиентов ======================
info "Генерирую уникальные данные для 4-х клиентов..."
OBFS_PASS=$(openssl rand -base64 32 | tr -d '/+=' | head -c 32)

declare -a CLIENT_NAMES=("client1" "client2" "client3" "client4")
declare -a CLIENT_PASSES=()

for i in {0..3}; do
    CLIENT_PASSES+=("$(openssl rand -base64 32 | tr -d '/+=' | head -c 32)")
done

# ====================== Установка Hysteria2 ======================
info "Устанавливаю Hysteria2..."
bash <(curl -fsSL https://get.hy2.sh/) > /tmp/hy2-install.log 2>&1 || {
    cat /tmp/hy2-install.log
    error "Не удалось установить Hysteria2"
}

# ====================== Подготовка директории и сертификата ======================
info "Создаю сертификат и настраиваю права..."

mkdir -p /etc/hysteria
rm -f /etc/hysteria/server.key /etc/hysteria/server.crt /etc/hysteria/config.yaml

openssl req -x509 -nodes -newkey rsa:2048 \
    -keyout /etc/hysteria/server.key \
    -out /etc/hysteria/server.crt \
    -days 3650 \
    -subj "/CN=www.microsoft.com" 2>/dev/null

chown -R hysteria:hysteria /etc/hysteria
chmod 700 /etc/hysteria
chmod 600 /etc/hysteria/server.key
chmod 644 /etc/hysteria/server.crt

# ====================== Конфиг ======================
info "Пишу конфиг с поддержкой 4-х пользователей (Строго IPv4)..."

cat > /etc/hysteria/config.yaml << EOF
listen: 0.0.0.0:${HY2_PORT}

tls:
  cert: /etc/hysteria/server.crt
  key: /etc/hysteria/server.key

auth:
  type: userpass
  userpass:
    ${CLIENT_NAMES[0]}: ${CLIENT_PASSES[0]}
    ${CLIENT_NAMES[1]}: ${CLIENT_PASSES[1]}
    ${CLIENT_NAMES[2]}: ${CLIENT_PASSES[2]}
    ${CLIENT_NAMES[3]}: ${CLIENT_PASSES[3]}

obfs:
  type: salamander
  salamander:
    password: ${OBFS_PASS}

masquerade:
  type: proxy
  proxy:
    url: https://www.microsoft.com
    rewriteHost: true

bandwidth:
  up: 300 mbps
  down: 1000 mbps

ignoreClientBandwidth: false
EOF

chown hysteria:hysteria /etc/hysteria/config.yaml
chmod 600 /etc/hysteria/config.yaml

# ====================== Запуск сервиса ======================
info "Запускаю сервис..."

systemctl daemon-reload
systemctl enable hysteria-server > /dev/null
systemctl restart hysteria-server

sleep 2

if systemctl is-active --quiet hysteria-server; then
    ok "Hysteria2 успешно запущен"
else
    echo
    journalctl -u hysteria-server -n 20 --no-pager
    error "Сервис не запустился"
fi

# ====================== Firewall ======================
info "Настраиваю firewall..."

if command -v ufw &>/dev/null; then
    ufw allow "${HY2_PORT}/udp" > /dev/null
    if [[ ! "$DISABLE_SSH" =~ ^[Yy]$ ]]; then
        ufw allow 22/tcp > /dev/null
    fi
    ufw --force enable > /dev/null 2>&1 || true
    ok "UFW: порт ${HY2_PORT}/udp открыт"
elif command -v firewall-cmd &>/dev/null; then
    firewall-cmd --permanent --add-port="${HY2_PORT}/udp" > /dev/null
    firewall-cmd --reload > /dev/null
    ok "firewalld: порт ${HY2_PORT}/udp открыт"
else
    warn "Firewall не найден. Открой порт ${HY2_PORT}/udp вручную!"
fi

# ====================== ОПРЕДЕЛЕНИЕ IPv4 АДРЕСА (Строгое) ======================
info "Определяю публичный IPv4-адрес сервера..."
# Флаг -4 принудительно запрашивает только IPv4
SERVER_IP=$(curl -4s --max-time 5 ifconfig.me || curl -4s --max-time 5 api.ipify.org || curl -4s --max-time 5 icanhazip.com)

# Проверка, что полученный адрес действительно похож на IPv4
if [[ -z "$SERVER_IP" || ! "$SERVER_IP" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    error "Не удалось определить корректный IPv4-адрес. Возможно, у сервера нет публичного IPv4 или есть проблемы с сетью."
fi

ok "IPv4-адрес сервера: ${SERVER_IP}"

# ====================== Сохраняем данные ======================
INFO_FILE="/root/hy2-info.txt"

cat > "${INFO_FILE}" << EOF
Hysteria2 Configuration (4 Clients, IPv4 Only)
==============================================
Date: $(date)
Server IP: ${SERVER_IP}
Port: ${HY2_PORT}
Obfs Password: ${OBFS_PASS}
SNI: www.microsoft.com

--- Client 1 ---
Name: ${CLIENT_NAMES[0]}
Password: ${CLIENT_PASSES[0]}
URI: hysteria2://${CLIENT_NAMES[0]}:${CLIENT_PASSES[0]}@${SERVER_IP}:${HY2_PORT}/?obfs=salamander&obfs-password=${OBFS_PASS}&sni=www.microsoft.com&insecure=1

--- Client 2 ---
Name: ${CLIENT_NAMES[1]}
Password: ${CLIENT_PASSES[1]}
URI: hysteria2://${CLIENT_NAMES[1]}:${CLIENT_PASSES[1]}@${SERVER_IP}:${HY2_PORT}/?obfs=salamander&obfs-password=${OBFS_PASS}&sni=www.microsoft.com&insecure=1

--- Client 3 ---
Name: ${CLIENT_NAMES[2]}
Password: ${CLIENT_PASSES[2]}
URI: hysteria2://${CLIENT_NAMES[2]}:${CLIENT_PASSES[2]}@${SERVER_IP}:${HY2_PORT}/?obfs=salamander&obfs-password=${OBFS_PASS}&sni=www.microsoft.com&insecure=1

--- Client 4 ---
Name: ${CLIENT_NAMES[3]}
Password: ${CLIENT_PASSES[3]}
URI: hysteria2://${CLIENT_NAMES[3]}:${CLIENT_PASSES[3]}@${SERVER_IP}:${HY2_PORT}/?obfs=salamander&obfs-password=${OBFS_PASS}&sni=www.microsoft.com&insecure=1
EOF

chmod 600 "${INFO_FILE}"

# ====================== Вывод ======================
clear
echo -e "${GREEN}"
echo "============================================================"
echo "          Hysteria2 успешно установлен и запущен"
echo "          Сервер максимально защищен (IPv4)"
echo "============================================================"
echo -e "${NC}"

if [[ "$DISABLE_SSH" =~ ^[Yy]$ ]]; then
    echo -e "${RED}⚠️  ВНИМАНИЕ: SSH ПОЛНОСТЬЮ ОТКЛЮЧЕН! ⚠️${NC}"
    echo -e "${RED}Управление сервером теперь возможно ТОЛЬКО через веб-консоль хостинга.${NC}"
    echo
fi

echo -e "${CYAN}Сервер (IPv4):${NC} ${SERVER_IP}"
echo -e "${CYAN}Порт:${NC}         ${HY2_PORT} (UDP)"
echo -e "${CYAN}Obfs пароль:${NC}  ${OBFS_PASS}"
echo -e "${CYAN}SNI:${NC}          www.microsoft.com"
echo

for i in {0..3}; do
    echo -e "${GREEN}=== Клиент $(($i+1)) (${CLIENT_NAMES[$i]}) ===${NC}"
    echo -e "${CYAN}Пароль:${NC} ${CLIENT_PASSES[$i]}"
    echo -e "${CYAN}URI (для быстрого импорта):${NC}"
    echo "hysteria2://${CLIENT_NAMES[$i]}:${CLIENT_PASSES[$i]}@${SERVER_IP}:${HY2_PORT}/?obfs=salamander&obfs-password=${OBFS_PASS}&sni=www.microsoft.com&insecure=1"
    echo
    
    echo -e "${CYAN}JSON для Hiddify (вручную):${NC}"
    cat << EOF
{
  "type": "hysteria2",
  "server": "${SERVER_IP}",
  "server_port": ${HY2_PORT},
  "password": "${CLIENT_PASSES[$i]}",
  "obfs": {
    "type": "salamander",
    "password": "${OBFS_PASS}"
  },
  "tls": {
    "enabled": true,
    "server_name": "www.microsoft.com",
    "insecure": true
  },
  "up_mbps": 100,
  "down_mbps": 500
}
EOF
    echo "------------------------------------------------------------"
done

echo -e "${YELLOW}Важно:${NC} В клиенте (Hiddify) обязательно включи Insecure / Skip Certificate Verify"
echo
echo -e "${CYAN}Данные также сохранены в:${NC} ${INFO_FILE}"
echo
echo -e "${CYAN}Полезные команды:${NC}"
echo "  systemctl status hysteria-server"
echo "  journalctl -u hysteria-server -f"
echo "  cat /root/hy2-info.txt"
echo
echo -e "${GREEN}Готово.${NC}"
