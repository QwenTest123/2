#!/bin/bash

set -euo pipefail

# ====================== Цвета ======================
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

info()  { echo -e "${CYAN}[INFO]${NC} $1"; }
ok()    { echo -e "${GREEN}[OK]${NC} $1"; }
warn()  { echo -e "${YELLOW}[WARN]${NC} $1"; }
error() { echo -e "${RED}[ERROR]${NC} $1"; exit 1; }

# ====================== Проверки ======================
[[ $EUID -ne 0 ]] && error "Запускай от root"

export DEBIAN_FRONTEND=noninteractive

info "Обновляю пакеты и ставлю зависимости..."
apt-get update -qq
apt-get install -y -qq curl openssl ca-certificates > /dev/null

# ====================== Выбор порта ======================
echo
info "Выбор порта для Hysteria2"
echo "1) Случайный высокий порт (рекомендуется)"
echo "2) Указать свой порт"
read -p "Выбери [1/2] (по умолчанию 1): " PORT_CHOICE
PORT_CHOICE=${PORT_CHOICE:-1}

if [[ "$PORT_CHOICE" == "2" ]]; then
    read -p "Введи UDP порт (30000-60000): " HY2_PORT
    [[ -z "${HY2_PORT}" || "${HY2_PORT}" -lt 1024 || "${HY2_PORT}" -gt 65535 ]] && error "Некорректный порт"
else
    HY2_PORT=$((RANDOM % 25000 + 35000))
fi

ok "Порт: ${HY2_PORT}/udp"

# ====================== Генерация паролей ======================
AUTH_PASS=$(openssl rand -base64 32 | tr -d '/+=' | head -c 32)
OBFS_PASS=$(openssl rand -base64 32 | tr -d '/+=' | head -c 32)

# ====================== Установка Hysteria2 ======================
info "Устанавливаю Hysteria2..."
bash <(curl -fsSL https://get.hy2.sh/) > /tmp/hy2-install.log 2>&1 || {
    cat /tmp/hy2-install.log
    error "Не удалось установить Hysteria2"
}

# ====================== Подготовка директории и сертификата ======================
info "Создаю сертификат и настраиваю права..."

mkdir -p /etc/hysteria
rm -f /etc/hysteria/server.key /etc/hysteria/server.crt

openssl req -x509 -nodes -newkey rsa:2048 \
    -keyout /etc/hysteria/server.key \
    -out /etc/hysteria/server.crt \
    -days 3650 \
    -subj "/CN=www.microsoft.com" 2>/dev/null

# Важно: правильные права для пользователя hysteria
chown -R hysteria:hysteria /etc/hysteria
chmod 700 /etc/hysteria
chmod 600 /etc/hysteria/server.key
chmod 644 /etc/hysteria/server.crt

# ====================== Конфиг ======================
info "Пишу конфиг..."

cat > /etc/hysteria/config.yaml << EOF
listen: :${HY2_PORT}

tls:
  cert: /etc/hysteria/server.crt
  key: /etc/hysteria/server.key

auth:
  type: password
  password: ${AUTH_PASS}

obfs:
  type: salamander
  salamander:
    password: ${OBFS_PASS}

masquerade:
  type: proxy
  proxy:
    url: https://www.microsoft.com
    rewriteHost: true

bandwidth:
  up: 300 mbps
  down: 1000 mbps

ignoreClientBandwidth: false
EOF

chown hysteria:hysteria /etc/hysteria/config.yaml
chmod 600 /etc/hysteria/config.yaml

# ====================== Запуск сервиса ======================
info "Запускаю сервис..."

systemctl daemon-reload
systemctl enable hysteria-server > /dev/null
systemctl restart hysteria-server

sleep 2

if systemctl is-active --quiet hysteria-server; then
    ok "Hysteria2 успешно запущен"
else
    echo
    journalctl -u hysteria-server -n 20 --no-pager
    error "Сервис не запустился"
fi

# ====================== Firewall ======================
info "Настраиваю firewall..."

if command -v ufw &>/dev/null; then
    ufw allow "${HY2_PORT}/udp" > /dev/null
    ufw allow 22/tcp > /dev/null
    ufw --force enable > /dev/null 2>&1 || true
    ok "UFW: порт ${HY2_PORT}/udp открыт"
elif command -v firewall-cmd &>/dev/null; then
    firewall-cmd --permanent --add-port="${HY2_PORT}/udp" > /dev/null
    firewall-cmd --reload > /dev/null
    ok "firewalld: порт ${HY2_PORT}/udp открыт"
else
    warn "Firewall не найден. Открой порт ${HY2_PORT}/udp вручную!"
fi

# ====================== IP сервера ======================
SERVER_IP=$(curl -s4 --max-time 5 ifconfig.me || curl -s4 --max-time 5 icanhazip.com || curl -s4 --max-time 5 ip.sb || echo "НЕ_УДАЛОСЬ_ОПРЕДЕЛИТЬ")

# ====================== Сохраняем данные ======================
INFO_FILE="/root/hy2-info.txt"

cat > "${INFO_FILE}" << EOF
Hysteria2 Configuration
=======================
Date: $(date)
Server IP: ${SERVER_IP}
Port: ${HY2_PORT}
Auth Password: ${AUTH_PASS}
Obfs Password: ${OBFS_PASS}
SNI: www.microsoft.com

URI:
hysteria2://${AUTH_PASS}@${SERVER_IP}:${HY2_PORT}/?obfs=salamander&obfs-password=${OBFS_PASS}&sni=www.microsoft.com&insecure=1
EOF

chmod 600 "${INFO_FILE}"

# ====================== Вывод ======================
clear
echo -e "${GREEN}"
echo "============================================================"
echo "          Hysteria2 успешно установлен и запущен"
echo "============================================================"
echo -e "${NC}"

echo -e "${CYAN}Сервер:${NC}       ${SERVER_IP}"
echo -e "${CYAN}Порт:${NC}         ${HY2_PORT} (UDP)"
echo -e "${CYAN}Auth пароль:${NC}  ${AUTH_PASS}"
echo -e "${CYAN}Obfs пароль:${NC}  ${OBFS_PASS}"
echo -e "${CYAN}SNI:${NC}          www.microsoft.com"
echo
echo -e "${YELLOW}Важно:${NC} В клиенте обязательно включи Insecure / Skip Certificate Verify"
echo

echo -e "${GREEN}=== Быстрая ссылка ===${NC}"
echo "hysteria2://${AUTH_PASS}@${SERVER_IP}:${HY2_PORT}/?obfs=salamander&obfs-password=${OBFS_PASS}&sni=www.microsoft.com&insecure=1"
echo

echo -e "${GREEN}=== JSON для клиентов ===${NC}"
cat << EOF
{
  "type": "hysteria2",
  "server": "${SERVER_IP}",
  "server_port": ${HY2_PORT},
  "password": "${AUTH_PASS}",
  "obfs": {
    "type": "salamander",
    "password": "${OBFS_PASS}"
  },
  "tls": {
    "enabled": true,
    "server_name": "www.microsoft.com",
    "insecure": true
  },
  "up_mbps": 100,
  "down_mbps": 500
}
EOF

echo
echo -e "${CYAN}Данные также сохранены в:${NC} ${INFO_FILE}"
echo
echo -e "${CYAN}Полезные команды:${NC}"
echo "  systemctl status hysteria-server"
echo "  journalctl -u hysteria-server -f"
echo "  cat /root/hy2-info.txt"
echo
echo -e "${GREEN}Готово.${NC}"
echo
