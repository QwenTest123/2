#!/bin/bash

set -e

# ====================== Цвета ======================
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

info()  { echo -e "${CYAN}[INFO]${NC} $1"; }
ok()    { echo -e "${GREEN}[OK]${NC} $1"; }
warn()  { echo -e "${YELLOW}[WARN]${NC} $1"; }
error() { echo -e "${RED}[ERROR]${NC} $1"; exit 1; }

# ====================== Проверки ======================
[[ $EUID -ne 0 ]] && error "Запускай от root (sudo -i)"

if ! command -v curl &>/dev/null; then
    apt update && apt install -y curl
fi

# ====================== Выбор порта ======================
echo
info "Выбор порта для Hysteria2"
echo "1) Случайный высокий порт (рекомендуется)"
echo "2) Указать свой порт"
read -p "Выбери [1/2] (по умолчанию 1): " PORT_CHOICE
PORT_CHOICE=${PORT_CHOICE:-1}

if [[ "$PORT_CHOICE" == "2" ]]; then
    read -p "Введи UDP порт (30000-60000): " HY2_PORT
    [[ -z "$HY2_PORT" || "$HY2_PORT" -lt 1024 || "$HY2_PORT" -gt 65535 ]] && error "Некорректный порт"
else
    HY2_PORT=$(( RANDOM % 25000 + 35000 ))   # 35000-59999
fi

ok "Будет использован порт: $HY2_PORT/udp"

# ====================== Генерация паролей ======================
AUTH_PASS=$(openssl rand -base64 24 | tr -d '/+=' | head -c 32)
OBFS_PASS=$(openssl rand -base64 24 | tr -d '/+=' | head -c 32)

# ====================== Установка Hysteria2 ======================
info "Устанавливаю Hysteria2..."
bash <(curl -fsSL https://get.hy2.sh/) || error "Не удалось установить Hysteria2"

# ====================== Сертификат ======================
info "Создаю самоподписанный сертификат..."
mkdir -p /etc/hysteria
openssl req -x509 -nodes -newkey rsa:2048 \
    -keyout /etc/hysteria/server.key \
    -out /etc/hysteria/server.crt \
    -days 3650 \
    -subj "/CN=www.microsoft.com" 2>/dev/null

chmod 600 /etc/hysteria/server.key
chmod 644 /etc/hysteria/server.crt

# ====================== Конфиг ======================
info "Создаю конфиг..."

cat > /etc/hysteria/config.yaml << EOF
listen: :${HY2_PORT}

tls:
  cert: /etc/hysteria/server.crt
  key: /etc/hysteria/server.key

auth:
  type: password
  password: ${AUTH_PASS}

obfs:
  type: salamander
  salamander:
    password: ${OBFS_PASS}

masquerade:
  type: proxy
  proxy:
    url: https://www.microsoft.com
    rewriteHost: true

bandwidth:
  up: 200 mbps
  down: 1000 mbps

ignoreClientBandwidth: false
EOF

# ====================== Systemd ======================
systemctl enable hysteria-server
systemctl restart hysteria-server

sleep 1
if systemctl is-active --quiet hysteria-server; then
    ok "Hysteria2 успешно запущен"
else
    error "Сервис не запустился. Смотри логи: journalctl -u hysteria-server -n 50"
fi

# ====================== Firewall ======================
info "Настраиваю firewall..."

if command -v ufw &>/dev/null; then
    ufw allow ${HY2_PORT}/udp >/dev/null
    ufw allow 22/tcp >/dev/null
    ufw --force enable >/dev/null 2>&1 || true
    ok "UFW: порт ${HY2_PORT}/udp открыт"
elif command -v firewall-cmd &>/dev/null; then
    firewall-cmd --permanent --add-port=${HY2_PORT}/udp
    firewall-cmd --reload
    ok "firewalld: порт ${HY2_PORT}/udp открыт"
else
    warn "Firewall не обнаружен. Открой порт ${HY2_PORT}/udp вручную!"
fi

# ====================== Получаем IP ======================
SERVER_IP=$(curl -s4 ifconfig.me || curl -s4 icanhazip.com || curl -s4 ip.sb)

# ====================== Вывод ======================
clear
echo -e "${GREEN}"
echo "========================================================"
echo "          Hysteria2 успешно установлен!"
echo "========================================================"
echo -e "${NC}"

echo -e "${CYAN}Сервер:${NC}     $SERVER_IP"
echo -e "${CYAN}Порт:${NC}       $HY2_PORT (UDP)"
echo -e "${CYAN}Auth пароль:${NC} $AUTH_PASS"
echo -e "${CYAN}Obfs пароль:${NC} $OBFS_PASS"
echo -e "${CYAN}SNI:${NC}        www.microsoft.com"
echo
echo -e "${YELLOW}Важно:${NC} Insecure / Skip Certificate Verify = ВКЛЮЧИТЬ"
echo

echo -e "${GREEN}=== Быстрая ссылка (Hysteria2 URI) ===${NC}"
echo "hysteria2://${AUTH_PASS}@${SERVER_IP}:${HY2_PORT}/?obfs=salamander&obfs-password=${OBFS_PASS}&sni=www.microsoft.com&insecure=1"
echo

echo -e "${GREEN}=== Конфиг для клиентов (JSON) ===${NC}"
cat << EOF
{
  "type": "hysteria2",
  "server": "${SERVER_IP}",
  "server_port": ${HY2_PORT},
  "password": "${AUTH_PASS}",
  "obfs": {
    "type": "salamander",
    "password": "${OBFS_PASS}"
  },
  "tls": {
    "enabled": true,
    "server_name": "www.microsoft.com",
    "insecure": true
  },
  "up_mbps": 100,
  "down_mbps": 500
}
EOF

echo
echo -e "${CYAN}Полезные команды:${NC}"
echo "  systemctl status hysteria-server"
echo "  journalctl -u hysteria-server -f"
echo "  nano /etc/hysteria/config.yaml"
echo
echo -e "${GREEN}Готово. Можно подключаться.${NC}"
echo
