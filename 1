#!/bin/bash
set -euo pipefail

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; CYAN='\033[0;36m'; NC='\033[0m'
info()  { echo -e "${CYAN}[INFO]${NC} $1"; }
ok()    { echo -e "${GREEN}[OK]${NC} $1"; }
warn()  { echo -e "${YELLOW}[WARN]${NC} $1"; }
error() { echo -e "${RED}[ERROR]${NC} $1"; exit 1; }

[[ $EUID -ne 0 ]] && error "Запускай от root"
command -v apt-get &>/dev/null || error "Только Debian/Ubuntu"
export DEBIAN_FRONTEND=noninteractive

info "Настройка безопасности и установка зависимостей..."
apt-get update -qq
apt-get install -y -qq curl openssl ca-certificates fail2ban unattended-upgrades > /dev/null
echo 'Unattended-Upgrade::Allowed-Origins:: "${distro_id}:${distro_codename}-security";' > /etc/apt/apt.conf.d/50unattended-upgrades
systemctl enable --now unattended-upgrades fail2ban

warn "⚠️ ВНИМАНИЕ: Отключить SSH? (Вход только через VNC хостинга)"
read -p "Отключить SSH? (y/N): " DISABLE_SSH
if [[ "$DISABLE_SSH" =~ ^[Yy]$ ]]; then
    systemctl stop sshd || true; systemctl disable sshd || true
    command -v ufw &>/dev/null && ufw deny 22/tcp > /dev/null 2>&1 || true
    ok "SSH отключен."
else
    info "SSH оставлен. Используй SSH-ключи!"
fi

# ЖЕСТКАЯ УСТАНОВКА ПОРТА 443
HY2_PORT=443
ok "Порт жестко установлен на: ${HY2_PORT}/udp (для обхода блокировок)"

info "Генерация данных для 4-х клиентов..."
OBFS_PASS=$(openssl rand -base64 32 | tr -d '/+=' | head -c 32)
declare -a CLIENT_NAMES=("client1" "client2" "client3" "client4")
declare -a CLIENT_PASSES=()
for i in {0..3}; do
    CLIENT_PASSES+=("$(openssl rand -base64 32 | tr -d '/+=' | head -c 32)")
done

info "Установка Hysteria2..."
bash <(curl -fsSL https://get.hy2.sh/) > /tmp/hy2-install.log 2>&1 || { cat /tmp/hy2-install.log; error "Ошибка установки"; }

info "Создание сертификата..."
mkdir -p /etc/hysteria
rm -f /etc/hysteria/server.key /etc/hysteria/server.crt /etc/hysteria/config.yaml
openssl req -x509 -nodes -newkey rsa:2048 -keyout /etc/hysteria/server.key -out /etc/hysteria/server.crt -days 3650 -subj "/CN=www.microsoft.com" 2>/dev/null
chown -R hysteria:hysteria /etc/hysteria
chmod 700 /etc/hysteria; chmod 600 /etc/hysteria/server.key; chmod 644 /etc/hysteria/server.crt

info "Вычисление SHA256 отпечатка для Xray-core..."
PIN_SHA256=$(openssl x509 -in /etc/hysteria/server.crt -noout -fingerprint -sha256 | sed 's/.*=//;s/://g')
ok "Отпечаток: ${PIN_SHA256:0:16}..."

info "Запись конфига..."
cat > /etc/hysteria/config.yaml << EOF
listen: 0.0.0.0:${HY2_PORT}
tls:
  cert: /etc/hysteria/server.crt
  key: /etc/hysteria/server.key
auth:
  type: userpass
  userpass:
    ${CLIENT_NAMES[0]}: ${CLIENT_PASSES[0]}
    ${CLIENT_NAMES[1]}: ${CLIENT_PASSES[1]}
    ${CLIENT_NAMES[2]}: ${CLIENT_PASSES[2]}
    ${CLIENT_NAMES[3]}: ${CLIENT_PASSES[3]}
obfs:
  type: salamander
  salamander:
    password: ${OBFS_PASS}
masquerade:
  type: proxy
  proxy:
    url: https://www.microsoft.com
    rewriteHost: true
bandwidth:
  up: 300 mbps
  down: 1000 mbps
ignoreClientBandwidth: false
EOF
chown hysteria:hysteria /etc/hysteria/config.yaml; chmod 600 /etc/hysteria/config.yaml

info "Запуск сервиса..."
systemctl daemon-reload; systemctl enable hysteria-server > /dev/null; systemctl restart hysteria-server
sleep 2
systemctl is-active --quiet hysteria-server || { journalctl -u hysteria-server -n 20 --no-pager; error "Сервис не запустился"; }
ok "Hysteria2 запущен"

info "Настройка фаервола..."
if command -v ufw &>/dev/null; then
    ufw allow "${HY2_PORT}/udp" > /dev/null
    [[ ! "$DISABLE_SSH" =~ ^[Yy]$ ]] && ufw allow 22/tcp > /dev/null
    ufw --force enable > /dev/null 2>&1 || true
    ok "UFW настроен"
fi

info "Определение IPv4..."
SERVER_IP=$(curl -4s --max-time 5 ifconfig.me || curl -4s --max-time 5 api.ipify.org || curl -4s --max-time 5 icanhazip.com)
[[ -z "$SERVER_IP" || ! "$SERVER_IP" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] && error "Не удалось определить IPv4"
ok "IPv4: ${SERVER_IP}"

INFO_FILE="/root/hy2-info.txt"
cat > "${INFO_FILE}" << EOF
Hysteria2 (Port 443, with pinSHA256 for Xray-core)
==================================================
Server IP: ${SERVER_IP}
Port: ${HY2_PORT}
Obfs Password: ${OBFS_PASS}
Cert SHA256: ${PIN_SHA256}
EOF
for i in {0..3}; do
    echo "Client $(($i+1)) Pass: ${CLIENT_PASSES[$i]}" >> "${INFO_FILE}"
done
chmod 600 "${INFO_FILE}"

clear
echo -e "${GREEN}============================================================${NC}"
echo -e "${GREEN}          HYSTERIA2 УСПЕШНО УСТАНОВЛЕН (ПОРТ 443)${NC}"
echo -e "${GREEN}          Конфиги оптимизированы для v2rayN/NekoRay${NC}"
echo -e "${GREEN}============================================================${NC}"
echo -e "${CYAN}Сервер:${NC} ${SERVER_IP}"
echo -e "${CYAN}Порт:${NC}   ${HY2_PORT} (UDP)"
echo -e "${CYAN}Obfs:${NC}   ${OBFS_PASS}"
echo

for i in {0..3}; do
    echo -e "${GREEN}=== Клиент $(($i+1)) ===${NC}"
    echo -e "${CYAN}Пароль:${NC} ${CLIENT_PASSES[$i]}"
    echo -e "${YELLOW}⚠️ ДЛЯ v2rayN / NekoRay (Xray-core) ИСПОЛЬЗУЙ ТОЛЬКО ЭТОТ JSON:⚠️${NC}"
    cat << EOF
{
  "type": "hysteria2",
  "server": "${SERVER_IP}",
  "server_port": ${HY2_PORT},
  "password": "${CLIENT_PASSES[$i]}",
  "obfs": {
    "type": "salamander",
    "password": "${OBFS_PASS}"
  },
  "tls": {
    "enabled": true,
    "server_name": "www.microsoft.com",
    "insecure": true,
    "pinSHA256": "${PIN_SHA256}"
  },
  "up_mbps": 100,
  "down_mbps": 500
}
EOF
    echo "------------------------------------------------------------"
done
echo -e "${CYAN}Данные сохранены в: /root/hy2-info.txt${NC}"
echo -e "${GREEN}Готово.${NC}"
